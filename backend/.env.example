PORT=3000
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
HOST=127.0.0.1
NODE_ENV=development
# Without DATABASE_URL, data is persisted in backend/data/postgres.
# DATABASE_URL=postgresql://user:password@localhost:5432/finance_space
DATABASE_SSL=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Finance Space <no-reply@example.com>
# TRUST_PROXY=1
# Optional AI + shared Telegram bot. Generate each secret independently; never commit real values.
# INTEGRATION_ENCRYPTION_KEY= (canonical base64 encoding of 32 random bytes)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME= (without @)
# TELEGRAM_WEBHOOK_SECRET= (32 or more random URL-safe characters)
